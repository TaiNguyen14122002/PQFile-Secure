# Dùng mật khẩu ngẫu nhiên mạnh trước khi triển khai công khai.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
STORAGE_ACCESS_KEY=pqfilestorage
STORAGE_SECRET_KEY=CHANGE_ME_STORAGE_PASSWORD
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8080

# Dữ liệu nghiên cứu: KHÔNG tự chạy seed. Dùng scripts/seed-research-macos.sh để
# nhập mật khẩu trong Terminal mà không ghi vào .env hoặc lịch sử shell.
# Chỉ sử dụng ở môi trường thử nghiệm, KHÔNG chạy trên cơ sở dữ liệu production.

# 32+ random characters, stable across API restarts; browser device HMAC pseudonyms
SECURITY_HMAC_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
